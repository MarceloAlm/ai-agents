{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/ornith-1.5:9b-coding",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama",
      "options": {
        "baseURL": "http://host.containers.internal:4000/v1",
        "apiKey": "ollama",
        "timeout": 300000
      },
      "models": {
        "ornith-1.5:9b-coding": {
          "name": "ornith-1.5:9b-coding",
          "limit": {
            "context": 16384,
            "output": 4096
          }
        }
      }
    }
  },
  "permission": {
    "bash": "allow",
    "read": "allow"
  }
}
