{
  "$schema": "https://opencode.ai/config.json",
  "model": "local/qwen2.5-coder:7b",
  "provider": {
    "local": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Local AI-Stack",
      "options": {
        "baseURL": "http://host.containers.internal:8081/v1",
        "apiKey": "local",
        "timeout": 300000
      },
      "models": {
        "qwen2.5-coder:7b": {
          "name": "qwen2.5-coder:7b",
          "limit": {
            "context": 8192,
            "output": 4096
          }
        },
        "deepseek-r1:7b": {
          "name": "deepseek-r1:7b",
          "limit": {
            "context": 8192,
            "output": 4096
          }
        }
      }
    }
  },
  "permission": {
    "bash": "allow",
    "read": "allow"
  }
}
