# Antigravity CLI com suporte a microfone e funções de áudio (:sound)
# Construído incrementalmente sobre a imagem oficial antigravity:latest
FROM antigravity:latest

USER root

# Provisionamento das bibliotecas de áudio via script modular
COPY scripts/setup-sound.sh /tmp/setup-sound.sh
RUN bash /tmp/setup-sound.sh && rm -f /tmp/setup-sound.sh

ENV AGY_VARIANT=sound

USER antigravity
