# Antigravity CLI com suporte a microfone e funções de áudio (:sound)
# Construído incrementalmente sobre a imagem oficial antigravity:latest
FROM antigravity:latest

USER root

# Hash do script de setup para invalidação de cache
ARG SETUP_HASH=

# Provisionamento das bibliotecas de áudio via script modular montado por bind
RUN --mount=type=bind,source=scripts/setup-sound.sh,target=/tmp/setup-sound.sh \
    echo "setup:${SETUP_HASH}" && bash /tmp/setup-sound.sh

ENV AGY_VARIANT=sound

USER antigravity
