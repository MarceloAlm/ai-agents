# Variante opencode:dotnet — Construída incrementalmente sobre a base opencode:latest
# Adiciona .NET 10 SDK, ferramentas de diagnóstico e LSP C# (Roslyn)
FROM opencode:latest

USER root

# Hash do script de setup: invalidação de cache do RUN (ver Dockerfile base)
ARG SETUP_HASH=

ENV OPENCODE_VARIANT=dotnet \
    PATH="/dotnet-tools:${PATH}" \
    DOTNET_CLI_TELEMETRY_OPTOUT=1 \
    DOTNET_NOLOGO=1

# Instalação do .NET SDK 10, ferramentas globais e LSP via script modular,
# montado por bind: sem camada COPY temporária com o script na história
RUN --mount=type=bind,source=scripts/setup-dotnet.sh,target=/tmp/setup-dotnet.sh \
    echo "setup:${SETUP_HASH}" && bash /tmp/setup-dotnet.sh

USER opencode
