# Variante opencode:dotnet — Construída incrementalmente sobre a base opencode:latest
# Adiciona .NET 10 SDK, ferramentas de diagnóstico e LSP C# (Roslyn)
FROM opencode:latest

USER root

# Instalação do .NET SDK 10 (repositório oficial Microsoft)
RUN wget -q https://packages.microsoft.com/config/debian/12/packages-microsoft-prod.deb -O packages-microsoft-prod.deb && \
    dpkg -i packages-microsoft-prod.deb && rm packages-microsoft-prod.deb && \
    apt-get update && \
    apt-get install -y --no-install-recommends dotnet-sdk-10.0 && \
    rm -rf /var/lib/apt/lists/*

# Ferramentas globais .NET (diagnóstico, análise e LSP)
RUN dotnet tool install --tool-path /dotnet-tools dotnet-trace \
    && dotnet tool install --tool-path /dotnet-tools dotnet-counters \
    && dotnet tool install --tool-path /dotnet-tools dotnet-dump \
    && dotnet tool install --tool-path /dotnet-tools roslynator.dotnet.cli \
    && dotnet tool install --tool-path /dotnet-tools roslyn-language-server --prerelease \
    && find /dotnet-tools/.store/roslyn-language-server -type f \
       \( -name 'roslyn-language-server' -o -name 'Microsoft.CodeAnalysis.LanguageServer' \) \
       -exec chmod +x {} +
RUN chown -R opencode:opencode /dotnet-tools
ENV PATH="/dotnet-tools:${PATH}" \
    DOTNET_CLI_TELEMETRY_OPTOUT=1 \
    DOTNET_NOLOGO=1

# Habilita LSP na configuração gerenciada do opencode
RUN printf '{\n  "$schema": "https://opencode.ai/config.json",\n  "lsp": true,\n  "skills": { "paths": ["/etc/opencode/skills"] },\n  "permission": {\n    "edit": "allow",\n    "bash": "allow",\n    "read": "allow",\n    "external_directory": { "*": "allow" }\n  }\n}\n' > /etc/opencode/opencode.json

# Marcação da variante dotnet
ENV OPENCODE_VARIANT=dotnet

USER opencode
