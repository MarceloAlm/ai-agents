# Variante opencode:dotnet — Construída incrementalmente sobre a base opencode:latest
# Adiciona .NET 10 SDK, ferramentas de diagnóstico e LSP C# (Roslyn)
FROM opencode:latest

USER root

ENV OPENCODE_VARIANT=dotnet \
    PATH="/dotnet-tools:${PATH}" \
    DOTNET_CLI_TELEMETRY_OPTOUT=1 \
    DOTNET_NOLOGO=1

# Instalação do .NET SDK 10, ferramentas globais e LSP via script modular
COPY scripts/setup-dotnet.sh /tmp/setup-dotnet.sh
RUN bash /tmp/setup-dotnet.sh && rm -f /tmp/setup-dotnet.sh

USER opencode
