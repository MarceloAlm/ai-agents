# Configurações de Ambiente para a Especialização 'exemplo-audit'

# Alvo ou etapa padrão:
# - 'all'     : Executa todas as 3 etapas sequencialmente
# - 'etapa1'  : Executa apenas a Etapa 1 (Componentes simples: SSH e PostgreSQL)
# - 'etapa2'  : Executa a Etapa 2 (Auditoria Integrada com SearXNG e Sandbox)
# - 'etapa3'  : Executa a Etapa 3 (Perícia Forense / Stress Test de alta complexidade)
AUDIT_TARGET=etapa1

# Janela temporal padrão
AUDIT_TIMEFRAME=now-24h

# Quantidade de amostras por alvo
LIMIT_SAMPLES=6

# Configurações para Envio de E-mail (SMTP)
# SEND_EMAIL=1
# EMAIL_TO=sre-team@empresa.com,secops@empresa.com
# EMAIL_FROM=specialized-agent@empresa.com
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=notificacoes@empresa.com
# SMTP_PASSWORD=sua-senha-aqui
# SMTP_TLS=1
# SMTP_SSL=0

# Integração com Metabuscador SearXNG (Container Isolado)
# ENABLE_WEB_SEARCH=1
# SEARXNG_URL=http://localhost:8080
